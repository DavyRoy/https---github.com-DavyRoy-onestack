{
    email info@onestack24.ru
    # optional: debug
}

# apex-домен (основной сайт)
onestack24.ru {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
    }

    @static path /_next/* /static/* /assets/* /favicon.ico /robots.txt /sitemap.xml
    handle @static {
        header Cache-Control "public, max-age=31536000, immutable"
        reverse_proxy onestack_app_prod:3000
    }

    @wellknown path /.well-known/*
    handle @wellknown {
        header Cache-Control "public, max-age=300"
        reverse_proxy onestack_app_prod:3000
    }

    handle {
        reverse_proxy onestack_app_prod:3000
    }
}

# CRM на поддомене
crm.onestack24.ru {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
    reverse_proxy onestack_suitecrm:8080
}

# www → apex (301 редирект)
www.onestack24.ru {
    redir https://onestack24.ru{uri} 301
}